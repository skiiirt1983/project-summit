# Project Summit — Waveshare ESP32-P4-WIFI6-Touch-LCD-5 (ESP32-P4NRW32)
CONFIG_IDF_TARGET="esp32p4"

# 32 MB NOR flash + fixed partition table (never change: see partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Two OTA slots with rollback; health gate lands in Phase 0 step 5.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Crash dumps go to the coredump partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# 32 MB in-package PSRAM
CONFIG_SPIRAM=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL fonts used by the shell's size tokens (shell/src/shell_ui.cpp font_for()).
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
