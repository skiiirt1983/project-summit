# Project Summit — Waveshare ESP32-P4-WIFI6-Touch-LCD-5 (ESP32-P4NRW32)
CONFIG_IDF_TARGET="esp32p4"

# 32 MB NOR flash + fixed partition table (never change: see partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Two OTA slots with rollback; health gate lands in Phase 0 step 5.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Crash dumps go to the coredump partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# 32 MB in-package PSRAM
CONFIG_SPIRAM=y
# Large allocations (LVGL, framebuffers, snapshot pictures) go to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
# Allocations up to this size normally go to internal RAM first (default 16 KB). LVGL's many small objects and
# network buffers filled the internal heap that the Wi-Fi link needs; 2 KB sends most of them to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048

# waveshare/esp_lcd_hx8394 by default runs another board's I2C setup (its own bus on GPIO7/8, a chip at 0x45).
# This board has no such chip, and that second bus took the pins from ours (touch then never answered).
CONFIG_ESP_LCD_HX8394_SKIP_I2C_INIT=y

# Wi-Fi: the P4 has none of its own. esp_wifi_remote sends the esp_wifi API over esp_hosted (SDIO, GPIO14-19,
# C6 reset GPIO54) to the ESP32-C6. The Waveshare board uses the same C6 wiring as Espressif's P4 function board.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
# The C6 on this board runs an OLD esp_hosted slave firmware (it reports version 0.0.0; the host is 2.13).
# 2026-11-22: plain per-packet SDIO reads at 20 MHz were tried against a crash in the sdio_read task and made
# HTTPS reads fail ("read failed"), so the default streaming mode at 40 MHz is back. The other suspect for that
# crash is the SD card service remounting while the Wi-Fi link is busy (same SDMMC controller): its retries are
# now rare (sd_card.cpp). See HARDWARE_TODO.md.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y

# The setup access point must never be a way into the home network: no IP forwarding or NAPT between the
# access point and the station interface.
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_IPV4_NAPT=n

# On-screen frame-rate / CPU readout (alpha builds; remove for release).
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y

# 1 ms RTOS tick: the UI loop sleeps in whole ticks (at the default 100 Hz a 5 ms delay rounded to 0 and starved
# the idle task, which tripped the task watchdog).
CONFIG_FREERTOS_HZ=1000

# The UI loop runs in the main task (LVGL needs room).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL fonts used by the shell's size tokens (shell/src/shell_ui.cpp font_for()).
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# Recipes panel: QR code to the web UI for PDF conversion.
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_SNAPSHOT=y

# LVGL uses the C library allocator (PSRAM-backed) rather than its fixed 64 KB pool, as in the simulator.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
